# https://editorconfig.org — keeps editors/IDEs consistent across contributors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go, Makefiles: hard tabs (gofmt / make requirement)
[{*.go,Makefile,*.mk}]
indent_style = tab

# Frontend sources follow the existing tab style
[*.{js,ts,svelte,json,css,html}]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false

[*.sql]
indent_style = space
indent_size = 4

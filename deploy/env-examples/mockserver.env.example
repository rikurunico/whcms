# WHCMS mockserver (whcms-mock) - CONTRACTS.md §12. Dev/E2E only.
# Mocks Duitku, WHM, DirectAdmin, RDash and captures outbound mail.

# HTTP listen port.
MOCK_PORT=9090

# Duitku mock credentials - the mock validates REAL MD5 signatures with these,
# so the backend's DUITKU_MERCHANT_CODE / DUITKU_API_KEY must match these values.
DUITKU_MERCHANT_CODE=DEMO
DUITKU_API_KEY=secretkey

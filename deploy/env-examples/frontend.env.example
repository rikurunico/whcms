# WHCMS frontend (SvelteKit SSR, adapter-node) - CONTRACTS.md §13.
# Copy to frontend/.env for local dev, or paste into Coolify/Dokploy secrets.

# Server-side base URL of the Go API (BFF calls; never exposed to the browser).
API_URL=http://localhost:8080

# Public (browser-visible) app name.
PUBLIC_APP_NAME=WHCMS

# --- adapter-node runtime (production container) ---
PORT=3000
# Fixed origin for form actions / CSRF when NOT behind a proxy:
ORIGIN=http://localhost:3000
# Behind a reverse proxy (Coolify/Dokploy Traefik) prefer deriving the origin
# from X-Forwarded-* headers instead of ORIGIN:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
